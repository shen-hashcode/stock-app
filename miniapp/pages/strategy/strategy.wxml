<!--pages/strategy/strategy.wxml-->
<view class="container">
  <view class="card">
    <view class="card-title">我的策略</view>
    <view class="btn-primary" bindtap="goCreate">+ 创建新策略</view>
  </view>

  <view class="strategy-list">
    <view class="strategy-card" wx:for="{{strategies}}" wx:key="id">
      <view class="strategy-header">
        <view class="strategy-name">{{item.name}}</view>
        <switch checked="{{item.is_active}}" bindchange="toggleStrategy" data-id="{{item.id}}" />
      </view>
      <view class="strategy-desc">{{item.description}}</view>
      <view class="strategy-actions">
        <view class="btn-run" bindtap="runStrategy" data-id="{{item.id}}">立即执行</view>
        <view class="btn-result" bindtap="viewResult" data-id="{{item.id}}">查看结果</view>
      </view>
    </view>
  </view>

  <view class="empty" wx:if="{{strategies.length === 0}}">
    <text>暂无策略，快去创建吧</text>
  </view>
</view>

<!-- 执行结果弹窗 -->
<view class="modal" wx:if="{{showResult}}">
  <view class="modal-mask" bindtap="closeModal"></view>
  <view class="modal-content">
    <view class="modal-title">筛选结果</view>
    <view class="result-count">找到 {{resultCount}} 只符合条件的股票</view>
    <scroll-view scroll-y class="result-list">
      <view class="stock-item" wx:for="{{resultStocks}}" wx:key="code">
        <view>
          <view class="stock-name">{{item.name}}</view>
          <view class="stock-code">{{item.code}}</view>
        </view>
        <view class="stock-change {{item.quote && item.quote.change_pct > 0 ? 'up' : 'down'}}">
          {{item.quote ? item.quote.change_pct : '--'}}%
        </view>
      </view>
    </scroll-view>
    <view class="btn-primary" bindtap="closeModal">关闭</view>
  </view>
</view>
