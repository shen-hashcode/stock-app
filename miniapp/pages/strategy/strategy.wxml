<view class="container">
  <!-- 顶部操作区 -->
  <view class="header-card">
    <view class="header-title">
      <text class="header-icon">◈</text>
      <text>我的策略</text>
    </view>
    <view class="header-count" wx:if="{{strategies.length > 0}}">{{strategies.length}}个策略</view>
  </view>

  <!-- 策略列表 -->
  <view class="strategy-list">
    <view class="strategy-card" wx:for="{{strategies}}" wx:key="id">
      <view class="card-glow"></view>
      <view class="strategy-header">
        <view class="strategy-name">{{item.name}}</view>
      </view>
      <view class="strategy-desc">{{item.description}}</view>
      <view class="glow-divider"></view>
      <view class="strategy-actions">
        <view class="btn-result" bindtap="viewResult" data-id="{{item.id}}">
          <text class="action-icon">◉</text> 查看结果
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{strategies.length === 0}}">
    <view class="empty-icon">◇</view>
    <text class="empty-text">暂无策略</text>
    <text class="empty-hint">在下方创建你的第一个AI策略</text>
  </view>

  <!-- 定制策略区 -->
  <view class="section ai-section">
    <view class="section-header">
      <view class="section-title">
        <text class="section-icon ai-icon">⚡</text>
        <text>创建新策略</text>
      </view>
    </view>
    <view class="ai-form">
      <view class="input-group">
        <view class="input-label">策略名称</view>
        <input class="input neon-input" placeholder="输入策略名称" placeholder-style="color:#4a5568" bindinput="onNameInput" value="{{customName}}" />
      </view>
      <view class="input-group">
        <view class="input-label">选股条件</view>
        <textarea class="input neon-input textarea" placeholder="描述你的选股条件，例如：&#10;前3天累计涨幅超过15%，第4天回调，市值大于100亿" placeholder-style="color:#4a5568" bindinput="onDescInput" value="{{customDesc}}" />
      </view>
      <view class="btn-primary ai-btn" bindtap="createCustomStrategy">
        <text class="btn-icon">✦</text> 生成策略
      </view>
    </view>
  </view>
</view>