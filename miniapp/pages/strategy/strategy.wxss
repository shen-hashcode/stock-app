/* 策略页 - 暗黑科技风 */
page {
  background-color: #0d1117;
}

/* 顶部卡片 */
.header-card {
  background: linear-gradient(135deg, rgba(22, 33, 62, 0.9) 0%, rgba(15, 23, 42, 0.95) 100%);
  border: 1rpx solid rgba(0, 212, 255, 0.15);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.header-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #e2e8f0;
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.header-icon {
  color: #00d4ff;
  margin-right: 12rpx;
}

.header-count {
  font-size: 22rpx;
  color: #8b95a5;
  margin-bottom: 24rpx;
}

.btn-create {
  background: linear-gradient(135deg, #00d4ff 0%, #7c3aed 100%);
  color: #fff;
  text-align: center;
  padding: 20rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 212, 255, 0.25);
}

.btn-create-icon {
  font-weight: 300;
  font-size: 32rpx;
}

/* 策略卡片 */
.strategy-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.strategy-card {
  position: relative;
  background: linear-gradient(135deg, rgba(22, 33, 62, 0.9) 0%, rgba(15, 23, 42, 0.95) 100%);
  border: 1rpx solid rgba(0, 212, 255, 0.1);
  border-radius: 20rpx;
  padding: 30rpx;
  overflow: hidden;
}

.card-glow {
  position: absolute;
  top: -30%;
  right: -10%;
  width: 200rpx;
  height: 200rpx;
  background: radial-gradient(circle, rgba(124, 58, 237, 0.06) 0%, transparent 70%);
  border-radius: 50%;
}

.strategy-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  position: relative;
}

.strategy-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #e2e8f0;
}

.strategy-desc {
  font-size: 24rpx;
  color: #8b95a5;
  margin-top: 12rpx;
  line-height: 1.6;
}

.glow-divider {
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(0, 212, 255, 0.2), transparent);
  margin: 24rpx 0;
}

.strategy-params {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
}

.strategy-actions {
  display: flex;
  gap: 20rpx;
}

.btn-result {
  flex: 1;
  background: rgba(139, 149, 165, 0.08);
  border: 1rpx solid rgba(139, 149, 165, 0.2);
  color: #8b95a5;
  text-align: center;
  padding: 18rpx;
  border-radius: 10rpx;
  font-size: 26rpx;
}

.btn-result:active {
  background: rgba(139, 149, 165, 0.15);
  color: #e2e8f0;
}

.action-icon {
  font-size: 20rpx;
  margin-right: 6rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 10rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #e2e8f0;
  display: flex;
  align-items: center;
}

.section-icon {
  margin-right: 12rpx;
  color: #00d4ff;
  font-size: 28rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 140rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  color: rgba(0, 212, 255, 0.3);
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #8b95a5;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #4a5568;
}

/* 定制策略表单 */
.ai-section {
  background: linear-gradient(135deg, rgba(22, 33, 62, 0.9) 0%, rgba(15, 23, 42, 0.95) 100%);
  border: 1rpx solid rgba(247, 181, 0, 0.15);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-top: 30rpx;
}

.ai-form {
  margin-top: 10rpx;
}

.input-group {
  margin-bottom: 24rpx;
}

.input-label {
  font-size: 24rpx;
  color: #8b95a5;
  margin-bottom: 12rpx;
  letter-spacing: 2rpx;
}

.neon-input {
  border-color: rgba(247, 181, 0, 0.2);
}

.neon-input:focus {
  border-color: #f7b500;
  box-shadow: 0 0 12rpx rgba(247, 181, 0, 0.15);
}

.textarea {
  height: 200rpx;
  width: 100%;
  box-sizing: border-box;
}

.ai-btn {
  background: linear-gradient(135deg, #f7b500 0%, #ff6b35 100%);
  box-shadow: 0 4rpx 20rpx rgba(247, 181, 0, 0.3);
}

.btn-icon {
  margin-right: 8rpx;
}

.ai-icon {
  color: #f7b500;
}
