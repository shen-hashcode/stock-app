/* 策略页 - 暗黑科技风 */
page {
  background-color: #0d1117;
}

/* 顶部卡片 */
.header-card {
  background: linear-gradient(135deg, rgba(22, 33, 62, 0.9) 0%, rgba(15, 23, 42, 0.95) 100%);
  border: 1rpx solid rgba(0, 212, 255, 0.15);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.header-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #e2e8f0;
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.header-icon {
  color: #00d4ff;
  margin-right: 12rpx;
}

.header-count {
  font-size: 22rpx;
  color: #8b95a5;
  margin-bottom: 24rpx;
}

.btn-create {
  background: linear-gradient(135deg, #00d4ff 0%, #7c3aed 100%);
  color: #fff;
  text-align: center;
  padding: 20rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 212, 255, 0.25);
}

.btn-create-icon {
  font-weight: 300;
  font-size: 32rpx;
}

/* 策略卡片 */
.strategy-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.strategy-card {
  position: relative;
  background: linear-gradient(135deg, rgba(22, 33, 62, 0.9) 0%, rgba(15, 23, 42, 0.95) 100%);
  border: 1rpx solid rgba(0, 212, 255, 0.1);
  border-radius: 20rpx;
  padding: 30rpx;
  overflow: hidden;
}

.card-glow {
  position: absolute;
  top: -30%;
  right: -10%;
  width: 200rpx;
  height: 200rpx;
  background: radial-gradient(circle, rgba(124, 58, 237, 0.06) 0%, transparent 70%);
  border-radius: 50%;
}

.strategy-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  position: relative;
}

.strategy-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #e2e8f0;
}

.strategy-desc {
  font-size: 24rpx;
  color: #8b95a5;
  margin-top: 12rpx;
  line-height: 1.6;
}

.glow-divider {
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(0, 212, 255, 0.2), transparent);
  margin: 24rpx 0;
}

.strategy-actions {
  display: flex;
  gap: 20rpx;
}

.btn-run {
  flex: 1;
  background: linear-gradient(135deg, rgba(0, 212, 255, 0.15) 0%, rgba(124, 58, 237, 0.1) 100%);
  border: 1rpx solid rgba(0, 212, 255, 0.3);
  color: #00d4ff;
  text-align: center;
  padding: 18rpx;
  border-radius: 10rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.btn-run:active {
  background: rgba(0, 212, 255, 0.25);
}

.btn-result {
  flex: 1;
  background: rgba(139, 149, 165, 0.08);
  border: 1rpx solid rgba(139, 149, 165, 0.2);
  color: #8b95a5;
  text-align: center;
  padding: 18rpx;
  border-radius: 10rpx;
  font-size: 26rpx;
}

.btn-result:active {
  background: rgba(139, 149, 165, 0.15);
  color: #e2e8f0;
}

.action-icon {
  font-size: 20rpx;
  margin-right: 6rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 140rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  color: rgba(0, 212, 255, 0.3);
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #8b95a5;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #4a5568;
}

/* Modal */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.modal-mask {
  position: absolute;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.7);
  backdrop-filter: blur(4px);
}

.modal-content {
  position: relative;
  width: 100%;
  background: linear-gradient(180deg, #1a2332 0%, #0d1117 100%);
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx;
  max-height: 80vh;
  z-index: 101;
  border-top: 1rpx solid rgba(0, 212, 255, 0.2);
}

.modal-decoration {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: linear-gradient(90deg, #00d4ff, #7c3aed, #f7b500);
  border-radius: 4rpx;
}

.modal-title {
  font-size: 36rpx;
  font-weight: bold;
  text-align: center;
  color: #e2e8f0;
  margin-bottom: 20rpx;
}

.result-summary {
  text-align: center;
  margin-bottom: 30rpx;
}

.result-number {
  font-size: 48rpx;
  font-weight: 800;
  color: #00d4ff;
  font-family: 'SF Mono', monospace;
}

.result-label {
  font-size: 26rpx;
  color: #8b95a5;
  margin-left: 10rpx;
}

.result-list {
  max-height: 50vh;
  margin-bottom: 30rpx;
}

.stock-info {
  flex: 1;
}
