/* 登录页 - 暗黑科技风 */
page {
  background-color: #0d1117;
  height: 100%;
}

.login-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 40rpx;
  position: relative;
  overflow: hidden;
}

/* 背景发光球 */
.bg-glow {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}

.bg-glow-1 {
  width: 500rpx;
  height: 500rpx;
  top: -10%;
  left: -20%;
  background: radial-gradient(circle, rgba(0, 212, 255, 0.08) 0%, transparent 70%);
}

.bg-glow-2 {
  width: 400rpx;
  height: 400rpx;
  bottom: 5%;
  right: -15%;
  background: radial-gradient(circle, rgba(124, 58, 237, 0.08) 0%, transparent 70%);
}

.bg-glow-3 {
  width: 300rpx;
  height: 300rpx;
  top: 30%;
  right: 10%;
  background: radial-gradient(circle, rgba(247, 181, 0, 0.05) 0%, transparent 70%);
}

/* Logo区域 */
.logo-area {
  text-align: center;
  margin-bottom: 60rpx;
  position: relative;
}

.logo-ring {
  width: 140rpx;
  height: 140rpx;
  margin: 0 auto 24rpx;
  border-radius: 50%;
  border: 3rpx solid transparent;
  background-image: linear-gradient(#0d1117, #0d1117), linear-gradient(135deg, #00d4ff, #7c3aed, #f7b500);
  background-origin: border-box;
  background-clip: padding-box, border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 0 40rpx rgba(0, 212, 255, 0.2), 0 0 80rpx rgba(124, 58, 237, 0.1);
  animation: ring-pulse 3s ease-in-out infinite;
}

@keyframes ring-pulse {
  0%, 100% { box-shadow: 0 0 40rpx rgba(0, 212, 255, 0.2), 0 0 80rpx rgba(124, 58, 237, 0.1); }
  50% { box-shadow: 0 0 60rpx rgba(0, 212, 255, 0.3), 0 0 120rpx rgba(124, 58, 237, 0.15); }
}

.logo-text {
  font-size: 52rpx;
  font-weight: 800;
  background: linear-gradient(135deg, #00d4ff 0%, #7c3aed 50%, #f7b500 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  letter-spacing: 6rpx;
}

.logo-subtitle {
  font-size: 24rpx;
  color: #8b95a5;
  margin-top: 12rpx;
  letter-spacing: 4rpx;
}

/* 登录卡片 */
.login-card {
  width: 100%;
  background: linear-gradient(135deg, rgba(22, 33, 62, 0.9) 0%, rgba(15, 23, 42, 0.95) 100%);
  border: 1rpx solid rgba(0, 212, 255, 0.12);
  border-radius: 28rpx;
  padding: 40rpx;
  backdrop-filter: blur(20px);
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.4);
}

/* 模式切换 */
.mode-toggle {
  display: flex;
  position: relative;
  background: rgba(0, 0, 0, 0.3);
  border-radius: 12rpx;
  padding: 6rpx;
  margin-bottom: 40rpx;
}

.mode-btn {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 28rpx;
  color: #8b95a5;
  position: relative;
  z-index: 2;
  transition: color 0.3s;
}

.mode-btn.active {
  color: #fff;
  font-weight: 600;
}

.mode-indicator {
  position: absolute;
  left: 6rpx;
  top: 6rpx;
  width: calc(50% - 6rpx);
  height: calc(100% - 12rpx);
  background: linear-gradient(135deg, #00d4ff 0%, #7c3aed 100%);
  border-radius: 10rpx;
  transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  z-index: 1;
}

.mode-indicator.right {
  transform: translateX(100%);
}

/* 表单 */
.form-area {
  margin-bottom: 36rpx;
}

.input-wrapper {
  display: flex;
  align-items: center;
  background: rgba(13, 17, 23, 0.8);
  border: 1rpx solid rgba(0, 212, 255, 0.15);
  border-radius: 14rpx;
  padding: 8rpx 20rpx;
  margin-bottom: 24rpx;
  transition: border-color 0.3s, box-shadow 0.3s;
}

.input-wrapper:focus-within {
  border-color: #00d4ff;
  box-shadow: 0 0 16rpx rgba(0, 212, 255, 0.15);
}

.input-icon-box {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
}

.input-icon-text {
  font-size: 32rpx;
  color: #00d4ff;
  opacity: 0.7;
}

.login-input {
  flex: 1;
  height: 80rpx;
  font-size: 28rpx;
  color: #e2e8f0;
  background: transparent;
}

/* 提交按钮 */
.submit-btn {
  width: 100%;
  background: linear-gradient(135deg, #00d4ff 0%, #7c3aed 100%);
  border-radius: 14rpx;
  padding: 24rpx 0;
  text-align: center;
  margin-bottom: 30rpx;
  position: relative;
  overflow: hidden;
  box-shadow: 0 6rpx 24rpx rgba(0, 212, 255, 0.3);
}

.submit-btn::after {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.12), transparent);
  animation: shimmer 3s infinite;
}

@keyframes shimmer {
  0% { left: -100%; }
  100% { left: 100%; }
}

.submit-btn:active {
  opacity: 0.85;
  transform: scale(0.98);
}

.submit-btn.disabled {
  opacity: 0.5;
  pointer-events: none;
}

.btn-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 8rpx;
}

/* 底部切换提示 */
.switch-hint {
  text-align: center;
}

.hint-text {
  font-size: 26rpx;
  color: #8b95a5;
}

.hint-link {
  font-size: 26rpx;
  color: #00d4ff;
  margin-left: 8rpx;
}
