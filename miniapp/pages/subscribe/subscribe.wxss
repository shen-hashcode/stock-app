page {
  background-color: #0d1117;
}

.page {
  padding: 30rpx;
}

/* 订阅状态卡片 */
.status-card {
  background: linear-gradient(135deg, #161b22, #1c2333);
  border: 1rpx solid #30363d;
  border-radius: 16rpx;
  padding: 36rpx;
  margin-bottom: 40rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.status-badge {
  font-size: 22rpx;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.status-badge.active {
  background: rgba(0, 212, 255, 0.15);
  color: #00d4ff;
  border: 1rpx solid rgba(0, 212, 255, 0.3);
}

.status-badge.inactive {
  background: rgba(139, 149, 165, 0.15);
  color: #8b95a5;
  border: 1rpx solid rgba(139, 149, 165, 0.3);
}

.status-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.pkg-name {
  font-size: 32rpx;
  color: #e6edf3;
  font-weight: 600;
}

.expire-text,
.quota-text {
  font-size: 24rpx;
  color: #8b95a5;
}

.hint-text {
  font-size: 26rpx;
  color: #8b95a5;
}

/* 标题 */
.section-title {
  font-size: 30rpx;
  color: #e6edf3;
  font-weight: 600;
  margin-bottom: 24rpx;
}

/* 套餐列表 */
.package-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.package-card {
  background: linear-gradient(135deg, #161b22, #1c2333);
  border: 1rpx solid #30363d;
  border-radius: 16rpx;
  padding: 36rpx;
}

.package-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.package-name {
  font-size: 34rpx;
  color: #e6edf3;
  font-weight: 700;
}

.package-price {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.price-num {
  font-size: 44rpx;
  color: #f7b500;
  font-weight: 800;
}

.price-unit {
  font-size: 22rpx;
  color: #8b95a5;
}

.package-desc {
  font-size: 26rpx;
  color: #8b95a5;
  margin-bottom: 20rpx;
}

.package-detail {
  display: flex;
  gap: 30rpx;
  font-size: 24rpx;
  color: #6e7681;
  margin-bottom: 28rpx;
}

.buy-btn {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  background: linear-gradient(135deg, #00d4ff, #7c3aed);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 12rpx;
  border: none;
  letter-spacing: 2rpx;
}

.buy-btn[disabled] {
  opacity: 0.5;
}

/* 加载 */
.loading-container {
  text-align: center;
  padding: 60rpx 0;
}

.loading-text {
  font-size: 26rpx;
  color: #8b95a5;
}
