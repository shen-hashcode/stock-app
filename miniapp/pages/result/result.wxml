<view class="container">
  <!-- 顶部标题 -->
  <view class="filter-card">
    <view class="filter-title">
      <text class="filter-icon">◉</text>
      <text>今日结果</text>
    </view>
  </view>

  <!-- 执行中提示 -->
  <view class="running-tip" wx:if="{{runningStrategies.length > 0}}">
    <view class="running-tip-inner">
      <view class="running-dot-wrap">
        <view class="running-dot"></view>
      </view>
      <text class="running-text">正在执行：{{runningStrategies[0].name}}{{runningStrategies.length > 1 ? ' 等' + runningStrategies.length + '个策略' : ''}}，完成后将自动显示结果</text>
    </view>
  </view>

  <!-- 结果列表 -->
  <view class="result-list">
    <view class="result-card" wx:for="{{results}}" wx:key="id">
      <view class="result-header" bindtap="toggleCard" data-index="{{index}}">
        <view class="result-date">
          <text class="date-dot"></text>
          {{item.strategy_name}}
        </view>
        <view class="result-count">
          <text class="count-number">{{item.count}}</text> 只
          <text class="fold-arrow {{item.collapsed ? '' : 'expanded'}}">∨</text>
        </view>
      </view>
      <view class="stock-list" wx:if="{{!item.collapsed}}">
        <view class="stock-item" wx:for="{{item.stocks}}" wx:for-item="stock" wx:key="code" bindtap="goStockDetail" data-code="{{stock.code}}" data-market="{{stock.market}}">
          <view class="stock-info">
            <view class="stock-name">{{stock.name}}</view>
            <view class="stock-code">{{stock.code}}</view>
          </view>
          <view class="stock-data">
            <view class="stock-change {{stock._changePct > 0 ? 'up' : 'down'}}">
              {{stock._changePct}}%
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 加载中 -->
  <view class="empty-state" wx:if="{{loading}}">
    <text class="empty-text">加载中...</text>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{!loading && results.length === 0}}">
    <view class="empty-icon">◇</view>
    <text class="empty-text">今日暂无筛选结果</text>
    <text class="empty-hint">执行策略后将在此显示当天结果</text>
  </view>
</view>