/* 股票详情页 - 暗黑科技风 */
page {
  background-color: #0d1117;
}

/* 股票卡片 */
.stock-card {
  background: linear-gradient(135deg, rgba(22, 33, 62, 0.9) 0%, rgba(15, 23, 42, 0.95) 100%);
  border: 1rpx solid rgba(0, 212, 255, 0.12);
  border-radius: 24rpx;
  overflow: hidden;
}

/* 价格区域 */
.price-section {
  position: relative;
  padding: 40rpx 30rpx;
  overflow: hidden;
}

.price-glow {
  position: absolute;
  top: 0;
  right: 0;
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  pointer-events: none;
}

.price-glow.glow-up {
  background: radial-gradient(circle, rgba(255, 77, 79, 0.08) 0%, transparent 70%);
}

.price-glow.glow-down {
  background: radial-gradient(circle, rgba(0, 185, 107, 0.08) 0%, transparent 70%);
}

.stock-header {
  display: flex;
  align-items: baseline;
  margin-bottom: 24rpx;
  position: relative;
}

.stock-name {
  font-size: 42rpx;
  font-weight: 800;
  color: #e2e8f0;
  margin-right: 16rpx;
}

.stock-code {
  font-size: 28rpx;
  color: #8b95a5;
  font-family: 'SF Mono', monospace;
}

.price-display {
  display: flex;
  align-items: baseline;
  position: relative;
}

.current-price {
  font-size: 72rpx;
  font-weight: 800;
  font-family: 'SF Mono', 'DIN Alternate', monospace;
  margin-right: 20rpx;
  letter-spacing: -2rpx;
}

.current-price.up {
  color: #ff4d4f;
  text-shadow: 0 0 20rpx rgba(255, 77, 79, 0.3);
}

.current-price.down {
  color: #00b96b;
  text-shadow: 0 0 20rpx rgba(0, 185, 107, 0.3);
}

.change-badge {
  font-size: 30rpx;
  font-weight: 700;
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  font-family: 'SF Mono', monospace;
}

.change-badge.up {
  color: #ff4d4f;
  background: rgba(255, 77, 79, 0.1);
  border: 1rpx solid rgba(255, 77, 79, 0.2);
}

.change-badge.down {
  color: #00b96b;
  background: rgba(0, 185, 107, 0.1);
  border: 1rpx solid rgba(0, 185, 107, 0.2);
}

/* 数据网格 */
.data-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  border-top: 1rpx solid rgba(0, 212, 255, 0.08);
}

.grid-item {
  padding: 28rpx 30rpx;
  border-bottom: 1rpx solid rgba(0, 212, 255, 0.06);
  border-right: 1rpx solid rgba(0, 212, 255, 0.06);
}

.grid-item:nth-child(2n) {
  border-right: none;
}

.grid-item.span-2 {
  grid-column: span 2;
  border-right: none;
  border-bottom: none;
}

.grid-label {
  font-size: 24rpx;
  color: #8b95a5;
  margin-bottom: 10rpx;
  letter-spacing: 2rpx;
}

.grid-value {
  font-size: 32rpx;
  color: #e2e8f0;
  font-weight: 600;
  font-family: 'SF Mono', 'DIN Alternate', monospace;
}

.grid-value.up {
  color: #ff4d4f;
}

.grid-value.down {
  color: #00b96b;
}

.grid-value.highlight {
  color: #f7b500;
  text-shadow: 0 0 8rpx rgba(247, 181, 0, 0.2);
}

/* 加载状态 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 0;
}

.loading-dots {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #00d4ff;
  animation: pulse 1.4s ease-in-out infinite;
}

.dot:nth-child(2) { animation-delay: 0.2s; }
.dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes pulse {
  0%, 80%, 100% { transform: scale(0.6); opacity: 0.4; }
  40% { transform: scale(1); opacity: 1; }
}

.loading-text {
  font-size: 26rpx;
  color: #8b95a5;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  color: rgba(0, 212, 255, 0.3);
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #8b95a5;
}
