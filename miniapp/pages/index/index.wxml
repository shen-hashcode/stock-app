<view class="container">
  <!-- 顶部Banner -->
  <view class="hero-banner">
    <view class="hero-glow"></view>
    <view class="hero-title">智能选股助手</view>
    <view class="hero-subtitle">AI驱动 · 量化筛选 · 精准捕捉</view>
    <view class="hero-decoration">
      <view class="particle p1"></view>
      <view class="particle p2"></view>
      <view class="particle p3"></view>
    </view>
  </view>

  <!-- 热门策略区 -->
  <view class="section">
    <view class="section-header">
      <view class="section-title">
        <text class="section-icon">◈</text>
        <text>热门策略</text>
      </view>
      <view class="section-badge">{{builtinStrategies.length}}个策略</view>
    </view>
    <view class="strategy-list">
      <view class="strategy-item {{runningKey === item.key ? 'running' : ''}}" wx:for="{{builtinStrategies}}" wx:key="key" bindtap="selectStrategy" data-key="{{item.key}}">
        <view class="strategy-glow"></view>
        <view class="strategy-name">{{item.name}}</view>
        <view class="strategy-desc">{{item.description}}</view>
        <view class="strategy-params">
          <view class="tag" wx:for="{{item.params}}" wx:for-item="param" wx:key="label">
            {{param.label}}: {{param.default}}
          </view>
        </view>
        <view class="strategy-run-hint" wx:if="{{runningKey !== item.key}}">
          <text class="run-icon">▶</text> 点击执行
        </view>
        <view class="strategy-loading" wx:if="{{runningKey === item.key}}">
          <view class="loading-dot"></view>
          <view class="loading-dot"></view>
          <view class="loading-dot"></view>
        </view>
      </view>
    </view>
  </view>

  <!-- AI自定义策略区 -->
  <view class="section ai-section">
    <view class="section-header">
      <view class="section-title">
        <text class="section-icon ai-icon">⚡</text>
        <text>AI定制策略</text>
      </view>
    </view>
    <view class="ai-form">
      <view class="input-group">
        <view class="input-label">策略名称</view>
        <input class="input neon-input" placeholder="输入策略名称" placeholder-style="color:#4a5568" bindinput="onNameInput" value="{{customName}}" />
      </view>
      <view class="input-group">
        <view class="input-label">选股条件</view>
        <textarea class="input neon-input textarea" placeholder="描述你的选股条件，例如：&#10;前3天累计涨幅超过15%，第4天回调，市值大于100亿" placeholder-style="color:#4a5568" bindinput="onDescInput" value="{{customDesc}}" />
      </view>
      <view class="btn-primary ai-btn" bindtap="createCustomStrategy">
        <text class="btn-icon">✦</text> AI生成策略
      </view>
    </view>
  </view>
</view>

<!-- 执行结果弹窗 -->
<view class="modal" wx:if="{{showResult}}">
  <view class="modal-mask" bindtap="closeModal"></view>
  <view class="modal-content">
    <view class="modal-decoration"></view>
    <view class="modal-title">筛选结果</view>
    <view class="result-count">
      <text class="result-number">{{resultCount}}</text>
      <text class="result-label">只符合条件的股票</text>
    </view>
    <scroll-view scroll-y class="result-list">
      <view class="stock-item" wx:for="{{resultStocks}}" wx:key="code">
        <view class="stock-info">
          <view class="stock-name">{{item.name}}</view>
          <view class="stock-code">{{item.code}}</view>
        </view>
        <view class="stock-change {{item.quote && item.quote.change_pct > 0 ? 'up' : 'down'}}">
          {{item.quote ? item.quote.change_pct : '--'}}%
        </view>
      </view>
    </scroll-view>
    <view class="btn-primary" bindtap="closeModal">关闭</view>
  </view>
</view>
