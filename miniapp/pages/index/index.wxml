<view class="container">
  <!-- 顶部Banner -->
  <view class="hero-banner">
    <view class="hero-glow"></view>
    <view class="hero-title">智能选股助手</view>
    <view class="hero-subtitle">AI驱动 · 量化筛选 · 精准捕捉</view>
    <view class="hero-decoration">
      <view class="particle p1"></view>
      <view class="particle p2"></view>
      <view class="particle p3"></view>
    </view>
  </view>

  <!-- 热门策略区 -->
  <view class="section">
    <view class="section-header">
      <view class="section-title">
        <text class="section-icon">◈</text>
        <text>热门策略</text>
      </view>
      <view class="section-badge">{{builtinStrategies.length}}个策略</view>
    </view>
    <view class="strategy-list">
      <view class="strategy-item {{runningKey === item.key ? 'running' : ''}}" wx:for="{{builtinStrategies}}" wx:key="key" bindtap="selectStrategy" data-key="{{item.key}}">
        <view class="strategy-glow"></view>
        <view class="strategy-name">{{item.name}}</view>
        <view class="strategy-desc">{{item.description}}</view>
        <view class="strategy-params">
          <view class="tag" wx:for="{{item.params}}" wx:for-item="param" wx:key="label">
            {{param.label}}: {{param.default}}
          </view>
        </view>
        <view class="strategy-run-hint">
          <text class="run-icon">▶</text> 点击查看
        </view>
      </view>
    </view>
  </view>

</view>

