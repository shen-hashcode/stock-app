/* 全局暗黑科技交易风格 */
page {
  background-color: #0d1117;
  color: #e2e8f0;
  font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'PingFang SC', sans-serif;
}

.container {
  padding: 20rpx;
  min-height: 100vh;
}

/* 主按钮 - 渐变科技风 */
.btn-primary {
  background: linear-gradient(135deg, #00d4ff 0%, #7c3aed 100%);
  color: #fff;
  border-radius: 12rpx;
  padding: 22rpx 40rpx;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
  letter-spacing: 2rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 212, 255, 0.3);
  position: relative;
  overflow: hidden;
}

.btn-primary::after {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.15), transparent);
  animation: shimmer 3s infinite;
}

@keyframes shimmer {
  0% { left: -100%; }
  100% { left: 100%; }
}

.btn-primary:active {
  opacity: 0.85;
  transform: scale(0.98);
}

/* 输入框 - 暗色边框 */
.input {
  border: 1rpx solid rgba(0, 212, 255, 0.2);
  border-radius: 12rpx;
  padding: 22rpx;
  font-size: 28rpx;
  margin-bottom: 20rpx;
  background: rgba(13, 17, 23, 0.8);
  color: #e2e8f0;
  transition: border-color 0.3s;
}

.input:focus {
  border-color: #00d4ff;
  box-shadow: 0 0 12rpx rgba(0, 212, 255, 0.2);
}

/* 标签 */
.tag {
  display: inline-block;
  background: rgba(0, 212, 255, 0.1);
  color: #00d4ff;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  margin-right: 12rpx;
  margin-bottom: 10rpx;
  border: 1rpx solid rgba(0, 212, 255, 0.2);
}

/* 涨跌色 */
.stock-change.up {
  color: #ff4d4f;
  text-shadow: 0 0 8rpx rgba(255, 77, 79, 0.3);
}

.stock-change.down {
  color: #00b96b;
  text-shadow: 0 0 8rpx rgba(0, 185, 107, 0.3);
}

/* 股票行项 */
.stock-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid rgba(0, 212, 255, 0.06);
}

.stock-item:last-child {
  border-bottom: none;
}

.stock-name {
  font-size: 30rpx;
  color: #e2e8f0;
  font-weight: 500;
}

.stock-code {
  font-size: 24rpx;
  color: #8b95a5;
  margin-top: 4rpx;
  font-family: 'SF Mono', 'Fira Code', monospace;
}

.stock-change {
  font-size: 28rpx;
  font-weight: bold;
  font-family: 'SF Mono', 'Fira Code', monospace;
}

/* 发光分隔线 */
.glow-divider {
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(0, 212, 255, 0.3), transparent);
  margin: 20rpx 0;
}
